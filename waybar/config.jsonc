{
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-click": "monolith-popup backlight",
    "scroll-step": 2
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-plugged": "󰂄 {capacity}%",
    "interval": 10,
    "on-click": "monolith-popup battery",
    "states": {
      "critical": 10,
      "warning": 20
    }
  },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "format-disabled": "󰂲",
    "on-click": "monolith-popup bluetooth",
    "tooltip-format": "{controller_alias}\t{controller_address}\n{num_connections} connected devices",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n{num_connections} connected devices\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "● {device_alias}\t{device_address}"
  },
  "clock": {
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%A, %d %b %Y  %H:%M}",
    "interval": 1,
    "tooltip": false
  },
  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 3,
    "on-click": "monolith-popup system"
  },
  "custom/drawer_toggle": {
    "format": "󰍜",
    "tooltip": "System Modules Drawer (Click to toggle)"
  },
  "custom/menu": {
    "format": "󰣇",
    "on-click": "~/.config/monolith/scripts/app-launcher.sh",
    "tooltip": "Application Menu (SUPER)"
  },
  "custom/nightlight": {
    "format": "󰃝",
    "on-click": "~/.config/monolith/scripts/nightlight.sh",
    "tooltip": "Toggle Night Light (Hyprsunset)"
  },
  "custom/notification": {
    "format": "󰂚",
    "on-click": "swaync-client -t -sw",
    "tooltip": "Notifications (SwayNC)"
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "monolith-popup power",
    "tooltip": "Power Menu"
  },
  "custom/settings": {
    "format": "󰒓",
    "on-click": "monolith-settings",
    "tooltip": "Monolith Settings (SUPER+I)"
  },
  "custom/spatial_tab": {
    "exec": "~/.config/monolith/scripts/waybar-spatial-tab.sh",
    "format": "{}",
    "interval": 2,
    "on-click": "~/.config/monolith/scripts/spatial-tab.sh up",
    "on-click-right": "~/.config/monolith/scripts/spatial-tab.sh down",
    "on-scroll-down": "~/.config/monolith/scripts/spatial-tab.sh down",
    "on-scroll-up": "~/.config/monolith/scripts/spatial-tab.sh up",
    "return-type": "json",
    "signal": 8
  },
  "group/drawer": {
    "drawer": {
      "children-class": "drawer-child",
      "click-to-reveal": true,
      "transition-duration": 250,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/drawer_toggle",
      "idle_inhibitor",
      "bluetooth",
      "network",
      "pulseaudio",
      "backlight",
      "battery",
      "cpu",
      "memory",
      "custom/nightlight"
    ],
    "orientation": "horizontal"
  },
  "height": 33,
  "hyprland/window": {
    "format": "│  {title}",
    "max-length": 40,
    "rewrite": {
      "(.*) - Chromium": "󰊯 $1",
      "(.*) - Zen Browser": "󰈹 $1",
      "(.*) — Mozilla Firefox": "󰈹 $1",
      "^$": "",
      "foot": " Terminal"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "all-outputs": true,
    "disable-scroll": true,
    "format": "{name}",
    "on-click": "activate"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈 AWAKE",
      "deactivated": "󰈉"
    },
    "tooltip": true,
    "tooltip-format-activated": "Keep Awake: ACTIVE (Screen & sleep inhibited)",
    "tooltip-format-deactivated": "Keep Awake: INACTIVE (Standard power management)"
  },
  "layer": "top",
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-top": 0,
  "memory": {
    "format": "󰘚 {used:0.1f}G",
    "interval": 5,
    "on-click": "monolith-popup system",
    "tooltip-format": "Used: {used:0.2f} GiB / {total:0.2f} GiB ({percentage}%)"
  },
  "modules-center": [
    "clock"
  ],
  "modules-left": [
    "custom/menu",
    "hyprland/workspaces",
    "custom/spatial_tab",
    "hyprland/window"
  ],
  "modules-right": [
    "idle_inhibitor",
    "bluetooth",
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "cpu",
    "memory",
    "custom/nightlight",
    "custom/settings",
    "custom/notification",
    "custom/power"
  ],
  "network": {
    "format-disconnected": "󰖪 off",
    "format-ethernet": "󰈀 {ifname}",
    "format-linked": "󰈀 link",
    "format-wifi": "󰖩 {essid}",
    "interval": 5,
    "on-click": "monolith-popup network",
    "tooltip-format": "{ifname} via {gwaddr} ({signalStrength}%)"
  },
  "position": "top",
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "hands-free": "󰋋",
      "headphone": "󰋋",
      "headset": "󰋋"
    },
    "format-muted": "󰖁 mut",
    "on-click": "monolith-popup audio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 2
  },
  "spacing": 0
}
