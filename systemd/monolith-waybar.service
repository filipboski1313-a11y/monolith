[Unit]
Description=Monolith Minimalist Status Bar (Waybar)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/waybar -c %h/.config/monolith/waybar/config.jsonc -s %h/.config/monolith/waybar/style.css
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
